# Retrieval-app config. Copy to .env.local (gitignored) to override.
# These are the PUBLIC Supabase project URL + anon key (safe to expose to the
# browser; row-level security protects the data). Setting them here lets you
# rotate the key or point at another project without editing source.
NEXT_PUBLIC_SUPA_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPA_KEY=your-anon-key

# Server-only integrations used by authenticated AI routes. Never expose these
# with NEXT_PUBLIC_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-key

# Optional: callers with this header value can run the paid deep health check.
# Public GET /api/health remains a free reachability check.
HEALTH_CHECK_SECRET=generate-a-long-random-secret

# Origins allowed to embed this app in an <iframe> (the ScienceKit lesson page).
# Space-separated. Default is the confirmed ScienceKit Vercel origin.
ALLOWED_FRAME_ANCESTORS=https://science-kit.vercel.app https://*.vercel.app http://localhost:3000
